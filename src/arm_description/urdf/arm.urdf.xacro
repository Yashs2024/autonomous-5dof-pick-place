<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="five_dof_arm">

  <xacro:arg name="use_sim" default="true"/>
  <xacro:property name="scale_mm" value="0.001 0.001 0.001"/>

  <material name="blue_pla">
    <color rgba="0.12 0.56 0.95 1.0"/>
  </material>
  <material name="white_pla">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>
  <material name="bin_green">
    <color rgba="0.15 0.68 0.38 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.22 0.22 0.22 1.0"/>
  </material>

  <xacro:macro name="clean_link" params="name stl color:='blue_pla' mass:=0.2">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://arm_description/meshes/${stl}" scale="${scale_mm}"/></geometry>
        <material name="${color}"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://arm_description/meshes/${stl}" scale="${scale_mm}"/></geometry>
      </collision>
      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>
  </xacro:macro>

  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:clean_link name="base_link"   stl="base_clean.stl"   color="white_pla" mass="1.0"/>
  <xacro:clean_link name="waist_link"  stl="waist_clean.stl"  color="blue_pla" mass="0.4"/>
  <xacro:clean_link name="arm_01_link" stl="arm_01_clean.stl" color="blue_pla" mass="0.3"/>
  <xacro:clean_link name="arm_02_link" stl="arm_02_clean.stl" color="blue_pla" mass="0.25"/>
  <xacro:clean_link name="arm_03_link" stl="arm_03_clean.stl" color="blue_pla" mass="0.15"/>

  <link name="gripper_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://arm_description/meshes/gripper_base_clean.stl" scale="${scale_mm}"/></geometry>
      <material name="white_pla"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://arm_description/meshes/servo_clean.stl" scale="${scale_mm}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://arm_description/meshes/gripper_base_clean.stl" scale="${scale_mm}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
    </inertial>
  </link>

  <link name="left_finger_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://arm_description/meshes/gear_left_clean.stl" scale="${scale_mm}"/></geometry>
      <material name="white_pla"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://arm_description/meshes/finger_left_clean.stl" scale="${scale_mm}"/></geometry>
      <material name="blue_pla"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://arm_description/meshes/finger_left_clean.stl" scale="${scale_mm}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>

  <link name="right_finger_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://arm_description/meshes/gear_right_clean.stl" scale="${scale_mm}"/></geometry>
      <material name="white_pla"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://arm_description/meshes/finger_right_clean.stl" scale="${scale_mm}"/></geometry>
      <material name="blue_pla"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://arm_description/meshes/finger_right_clean.stl" scale="${scale_mm}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="waist_link"/>
    <origin xyz="0.00000 0.00000 0.05750" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.8" friction="0.2"/>
    <limit lower="-3.1415" upper="3.1415" effort="15.0" velocity="2.0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="waist_link"/>
    <child link="arm_01_link"/>
    <origin xyz="-0.02220 0.00428 0.03866" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.8" friction="0.2"/>
    <limit lower="-1.5708" upper="1.5708" effort="15.0" velocity="2.0"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="arm_01_link"/>
    <child link="arm_02_link"/>
    <origin xyz="0.00681 0.00000 0.11423" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.8" friction="0.2"/>
    <limit lower="-2.0" upper="2.0" effort="12.0" velocity="2.0"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="arm_02_link"/>
    <child link="arm_03_link"/>
    <origin xyz="0.00313 0.00659 0.09735" rpy="0 0 0"/>
    <axis xyz="0.0321 0.0000 0.9995"/>
    <dynamics damping="0.8" friction="0.2"/>
    <limit lower="-3.1415" upper="3.1415" effort="10.0" velocity="2.5"/>
  </joint>

  <joint name="joint_5" type="revolute">
    <parent link="arm_03_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0.00607 0.01120 0.03247" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.8" friction="0.2"/>
    <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="3.0"/>
  </joint>

  <joint name="gripper_left_joint" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0.00832 -0.01387 0.03679" rpy="0 0 0"/>
    <axis xyz="0.99760 -0.00075 0.06918"/>
    <dynamics damping="0.4" friction="0.1"/>
    <limit lower="-0.280" upper="0.6" effort="10.0" velocity="0.8"/>
  </joint>

  <joint name="gripper_right_joint" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0.01025 0.00825 0.03386" rpy="0 0 0"/>
    <axis xyz="-0.99760 0.00075 -0.06918"/>
    <dynamics damping="0.4" friction="0.1"/>
    <limit lower="-0.280" upper="0.6" effort="10.0" velocity="0.8"/>
  </joint>

  <!-- High-friction finger pads for grasping objects in Gazebo -->
  <gazebo reference="left_finger_link">
    <mu1>50.0</mu1>
    <mu2>50.0</mu2>
    <kp>100000.0</kp>
    <kd>10.0</kd>
  </gazebo>
  <gazebo reference="right_finger_link">
    <mu1>50.0</mu1>
    <mu2>50.0</mu2>
    <kp>100000.0</kp>
    <kd>10.0</kd>
  </gazebo>

  <!-- ros2_control hardware interface -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <xacro:if value="$(arg use_sim)">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_sim)">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:unless>
    </hardware>

    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_4">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_5">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_left_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_right_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <position_proportional_gain>1.8</position_proportional_gain>
      <parameters>$(find arm_moveit_config)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>


  <!-- Pedestal Table for Target Cube -->
  <link name="cube_pedestal_link">
    <visual>
      <origin xyz="0.2691 0.0193 0.0554" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.1109"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0.2691 0.0193 0.0554" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.1109"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0.2691 0.0193 0.0554" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="pedestal_fixed" type="fixed">
    <parent link="world"/>
    <child link="cube_pedestal_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Open-Top Drop-Off Box at joint_1 = 1.2 rad -->
  <link name="drop_box_link">
    <!-- Box Base/Floor -->
    <visual>
      <origin xyz="0.0997 0.2565 0.0200" rpy="0 0 1.2000"/>
      <geometry><box size="0.1160 0.1160 0.0400"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0.0997 0.2565 0.0200" rpy="0 0 1.2000"/>
      <geometry><box size="0.1160 0.1160 0.0400"/></geometry>
    </collision>

    <!-- +X Wall -->
    <visual>
      <origin xyz="0.1196 0.3078 0.0650" rpy="0 0 1.2000"/>
      <geometry><box size="0.0060 0.1160 0.0500"/></geometry>
      <material name="bin_green"/>
    </visual>
    <collision>
      <origin xyz="0.1196 0.3078 0.0650" rpy="0 0 1.2000"/>
      <geometry><box size="0.0060 0.1160 0.0500"/></geometry>
    </collision>

    <!-- -X Wall -->
    <visual>
      <origin xyz="0.0798 0.2052 0.0650" rpy="0 0 1.2000"/>
      <geometry><box size="0.0060 0.1160 0.0500"/></geometry>
      <material name="bin_green"/>
    </visual>
    <collision>
      <origin xyz="0.0798 0.2052 0.0650" rpy="0 0 1.2000"/>
      <geometry><box size="0.0060 0.1160 0.0500"/></geometry>
    </collision>

    <!-- +Y Wall -->
    <visual>
      <origin xyz="0.0484 0.2764 0.0650" rpy="0 0 1.2000"/>
      <geometry><box size="0.1040 0.0060 0.0500"/></geometry>
      <material name="bin_green"/>
    </visual>
    <collision>
      <origin xyz="0.0484 0.2764 0.0650" rpy="0 0 1.2000"/>
      <geometry><box size="0.1040 0.0060 0.0500"/></geometry>
    </collision>

    <!-- -Y Wall -->
    <visual>
      <origin xyz="0.1510 0.2366 0.0650" rpy="0 0 1.2000"/>
      <geometry><box size="0.1040 0.0060 0.0500"/></geometry>
      <material name="bin_green"/>
    </visual>
    <collision>
      <origin xyz="0.1510 0.2366 0.0650" rpy="0 0 1.2000"/>
      <geometry><box size="0.1040 0.0060 0.0500"/></geometry>
    </collision>

    <inertial>
      <mass value="2.0"/>
      <origin xyz="0.0997 0.2565 0.0200" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="drop_box_fixed" type="fixed">
    <parent link="world"/>
    <child link="drop_box_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <gazebo reference="drop_box_link">
    <material>Gazebo/Green</material>
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
  </gazebo>
</robot>
