          </material>
        </visual>
        <visual name="rack_shelf_2">
          <pose>-0.25 3.0 0.65 0 0 0</pose>
          <geometry>
            <box><size>2.6 0.85 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.4 0.0 1</ambient>
            <diffuse>0.95 0.45 0.05 1</diffuse>
          </material>
        </visual>
        <visual name="cargo_box_1">
          <pose>-0.8 3.0 0.12 0 0 0.1</pose>
          <geometry>
            <box><size>0.5 0.5 0.48</size></box>
          </geometry>
          <material>
            <ambient>0.65 0.48 0.30 1</ambient>
            <diffuse>0.72 0.54 0.34 1</diffuse>
          </material>
        </visual>
        <visual name="cargo_box_2">
          <pose>0.3 3.0 0.10 0 0 -0.05</pose>
          <geometry>
            <box><size>0.55 0.45 0.44</size></box>
          </geometry>
          <material>
            <ambient>0.65 0.48 0.30 1</ambient>
            <diffuse>0.72 0.54 0.34 1</diffuse>
          </material>
        </visual>
        <visual name="plc_cabinet">
          <pose>-1.2 -2.2 0.25 0 0 0.4</pose>
          <geometry>
            <box><size>0.6 0.8 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.62 0.65 1</ambient>
            <diffuse>0.65 0.68 0.70 1</diffuse>
          </material>
        </visual>
        <visual name="bollard_1">
          <pose>1.05 1.05 -0.30 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.045</radius><length>0.90</length></cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.75 0.0 1</ambient>
            <diffuse>0.95 0.75 0.0 1</diffuse>
          </material>
        </visual>
        <visual name="bollard_2">
          <pose>1.05 -1.05 -0.30 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.045</radius><length>0.90</length></cylinder>
          </geometry>
          <material>
